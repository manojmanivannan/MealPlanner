# ==============================================================================
# MealPlanner Environment Configuration
# Copy this file to .env and adjust the values for your setup:
#   cp .env.example .env
# ==============================================================================

# --- Database Configuration ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=recipes

# --- Default Application Web Login Credentials ---
# The default user seeded upon database initialization
DEFAULT_USER_EMAIL=demo@demo.com
DEFAULT_USER_PASSWORD=demo123

# --- Authentication & JWT Security (Optional) ---
# MEALPLANNER_SECRET=devsecret
# MEALPLANNER_TOKEN_MINUTES=1440

# --- Tailscale VPN (Required only for 'prod' profile) ---
# TS_AUTHKEY=tskey-auth-xxxxxx

# --- Email / SMTP Settings (Optional) ---
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=admin@example.com
# SMTP_PASSWORD=secret
# FROM_EMAIL=admin@example.com
